QWidget{font-size:13px;}
QPushButton{padding:5px 10px;border:1px solid #aaa;border-radius:6px;}
QPushButton:hover{border-color:#b4531f;}
QListWidget{border:1px solid #bbb;border-radius:6px;}
QListWidget::item{padding:5px;}
QListWidget::item:selected{background:#b4531f;color:white;}
QLineEdit,QComboBox{padding:4px;border:1px solid #aaa;border-radius:6px;}
QSlider::groove:horizontal{height:4px;background:#bbb;border-radius:2px;}
QSlider::handle:horizontal{background:#b4531f;width:14px;margin:-6px 0;border-radius:7px;}
